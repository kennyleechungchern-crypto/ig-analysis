# Instagram Graph API（长期 Token，有效期 60 天，需定期刷新）
IG_ACCESS_TOKEN=your_long_lived_access_token_here

# Claude API Key（从 console.anthropic.com 获取）
ANTHROPIC_API_KEY=sk-ant-...

# Notion Integration Token（从 notion.so/my-integrations 获取）
NOTION_TOKEN=secret_...

# 要在哪个 Notion 页面下创建报告（从页面 URL 取最后的 UUID）
NOTION_PAGE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
